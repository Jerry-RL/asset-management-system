{
  "name": "asset-management-system-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "资产经营管理系统 — 前端 Monorepo（admin-web + h5-tenant + h5-worker + 小程序）",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:lint": "redocly lint ../docs/api/openapi.yaml",
    "api:preview": "redocly preview-docs ../docs/api/openapi.yaml",
    "db:schemadoc": "docker compose -f ../docs/database/schemadoc/docker-compose.yml run --rm schemadoc",
    "dev": "pnpm --filter admin-web dev",
    "dev:tenant": "pnpm --filter h5-tenant dev",
    "dev:worker": "pnpm --filter h5-worker dev",
    "build": "pnpm --filter admin-web build",
    "build:tenant": "pnpm --filter h5-tenant build",
    "build:worker": "pnpm --filter h5-worker build",
    "build:all": "pnpm --filter admin-web build && pnpm --filter h5-tenant build && pnpm --filter h5-worker build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@redocly/cli": "^1.25.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0"
  }
}
