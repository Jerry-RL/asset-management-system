<view class="card">
  <view class="field">
    <text class="label">姓名</text>
    <input placeholder="请输入真实姓名" data-field="name" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="label">手机号</text>
    <input type="number" placeholder="请输入手机号" data-field="phone" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="label">证件号</text>
    <input placeholder="身份证号（选填）" data-field="idNo" bindinput="onInput" />
  </view>
  <button class="btn-primary" bindtap="submit" loading="{{loading}}">实名认证并绑定</button>
  <view class="tip">绑定后即可关联名下签约资产与合同</view>
</view>
