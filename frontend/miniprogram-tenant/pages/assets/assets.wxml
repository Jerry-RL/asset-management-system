<view class="page">
  <view class="banner" bindtap="goTender">📢 公开招租 · 在线报名 ›</view>
  <block wx:for="{{list}}" wx:key="id">
    <view class="card" bindtap="goDetail" data-id="{{item.assetId}}">
      <image wx:if="{{item.coverImageUrl}}" class="cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
      <view class="body">
        <view class="title-row">
          <text class="title">{{item.title}}</text>
          <text wx:if="{{item.recommended}}" class="badge">推荐</text>
        </view>
        <view class="rent">{{item.rentLabel}}</view>
        <view wx:if="{{item.introText}}" class="intro">{{item.introText}}</view>
      </view>
    </view>
  </block>
  <view wx:if="{{!loading && list.length === 0}}" class="empty">暂无招租资产</view>
</view>
