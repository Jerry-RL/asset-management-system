.banner {
  background: #1f6feb;
  color: #fff;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
}
.title {
  font-weight: bold;
}
.rent {
  color: #e8590c;
  font-size: 32rpx;
  font-weight: bold;
  margin: 8rpx 0;
}
.status {
  color: #999;
  font-size: 24rpx;
}
.empty {
  text-align: center;
  color: #bbb;
  padding: 100rpx;
}
