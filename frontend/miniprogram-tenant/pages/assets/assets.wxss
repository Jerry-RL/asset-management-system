.banner {
  background: #1f6feb;
  color: #fff;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
}
.card {
  display: flex;
  flex-direction: row;
  background: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.06);
}
.cover {
  width: 220rpx;
  height: 176rpx;
  flex-shrink: 0;
  background: #eef2f7;
}
.body {
  flex: 1;
  padding: 16rpx 20rpx;
  min-width: 0;
}
.title-row {
  display: flex;
  align-items: center;
}
.title {
  font-weight: bold;
  font-size: 30rpx;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.badge {
  margin-left: 10rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #b45309;
  background: #fef3c7;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.rent {
  color: #e8590c;
  font-size: 32rpx;
  font-weight: bold;
  margin: 8rpx 0;
}
.intro {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.status {
  color: #999;
  font-size: 24rpx;
}
.empty {
  text-align: center;
  color: #bbb;
  padding: 100rpx;
}
