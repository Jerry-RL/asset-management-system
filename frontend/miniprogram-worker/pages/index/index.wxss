.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
}
.tab {
  padding: 24rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}
.active {
  color: #0f766e;
  border-bottom-color: #0f766e;
  font-weight: bold;
}
.top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.type {
  font-weight: bold;
}
.status {
  color: #0f766e;
  font-size: 24rpx;
}
.sub {
  color: #999;
  font-size: 24rpx;
}
.btns {
  margin-top: 16rpx;
}
.btns button {
  margin-right: 12rpx;
}
.empty {
  text-align: center;
  color: #bbb;
  padding: 100rpx;
}
