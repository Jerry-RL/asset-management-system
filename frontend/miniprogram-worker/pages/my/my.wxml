<view class="page">
  <view class="profile">
    <view class="name">{{user.name || '外勤人员'}}</view>
    <view class="sub">工作端 · 一线运维</view>
  </view>
  <view class="grid">
    <view wx:for="{{menu}}" wx:key="url" class="grid-item" bindtap="go" data-url="{{item.url}}">
      <text>{{item.title}}</text>
    </view>
  </view>
</view>
