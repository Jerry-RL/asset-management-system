.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  padding: 20rpx 24rpx;
}
.search-bar input {
  flex: 1;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 12rpx;
}
.title {
  font-weight: bold;
  margin-bottom: 8rpx;
}
.row {
  color: #666;
  font-size: 24rpx;
  padding: 4rpx 0;
}
.empty {
  text-align: center;
  color: #bbb;
  padding: 100rpx;
}
