{
  "name": "asset-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "资产经营管理系统 — 文档与工程化工具",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:lint": "redocly lint docs/api/openapi.yaml",
    "api:preview": "redocly preview-docs docs/api/openapi.yaml",
    "db:schemadoc": "docker compose -f docs/database/schemadoc/docker-compose.yml run --rm schemadoc"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@redocly/cli": "^1.25.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0"
  }
}
